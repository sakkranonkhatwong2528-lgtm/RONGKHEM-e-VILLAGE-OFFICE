<script>

/* =========================
   DIGITAL CLOCK
========================= */

function updateClock(){

    const now = new Date();

    const time =
        now.toLocaleTimeString(
            "th-TH",
            {
                hour:"2-digit",
                minute:"2-digit",
                second:"2-digit",
                hour12:false
            }
        );

    const date =
        now.toLocaleDateString(
            "th-TH",
            {
                weekday:"long",
                year:"numeric",
                month:"long",
                day:"numeric"
            }
        );

    document.getElementById("clock")
        .textContent = time;

    document.getElementById("date")
        .textContent = date;

}

updateClock();

setInterval(updateClock,1000);


/* =========================
   MOBILE MENU
========================= */

function toggleMenu(){

    document
        .getElementById("sidebar")
        .classList.toggle("open");

}

</script>

